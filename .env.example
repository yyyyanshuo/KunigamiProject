# SakiGlobal 配置清单：以当前读取代码为准；凭据一律留空，不是已配置服务。
# 优先级：显式进程环境变量 > 本目录 .env > 代码默认；绝不搜索父目录/旧项目。
# 本地 true=离线 MOCK；填入第三方凭据也不会自动开通真实调用。
# 以下注释项是可选项；不需要就保持注释，数值/日期不要取消注释后填空。
# 已有 .env/加密密钥不得覆盖。每项下面列出用途、格式、要求/缺失影响、获取方式。

# KUNIGAMI_ENV — 运行模式；优先于 FLASK_ENV
# 格式：development/test/testing；正式部署 production/prod
# 要求/缺失影响：本地推荐显式；未设置回退 FLASK_ENV，再回退 development；生产会启用 Secure Cookie
# 获取：自行选择，当前保持 development
KUNIGAMI_ENV=development

# FLASK_ENV — 仅本应用兼容旧环境名的回退项
# 格式：与 KUNIGAMI_ENV 同格式
# 要求/缺失影响：可省略；KUNIGAMI_ENV 非空时不生效；不是现代 Flask 的开发模式开关
# 获取：不需获取，推荐只设置 KUNIGAMI_ENV
# FLASK_ENV=

# SAKI_LOCAL_TEST — 离线模拟、网络与路径保护
# 格式：true/false（不带空格），缺省 true
# 要求/缺失影响：本地启动器必须 true；生产同时启用会拒绝；false 不等于已授权真实调用
# 获取：当前保留 true
SAKI_LOCAL_TEST=true

# SAKI_DATA_ROOT — 新环境可写数据根目录
# 格式：相对当前代码根目录或绝对路径；本地限 .local-data 内，测试限 /tmp/saki-*
# 要求/缺失影响：本地必填；缺失/越界拒绝启动；不读取旧站数据库
# 获取：当前保留本项目独立路径
SAKI_DATA_ROOT=.local-data/global

# SAKI_PORT — saki_local.py/app.py 的 HTTP 端口
# 格式：整数 1–65535
# 要求/缺失影响：可省略；本地默认 5001；init 首次建 .env 探测空闲端口；Gunicorn 不使用此项
# 获取：自行选择空闲本机端口
SAKI_PORT=5001

# FLASK_SECRET_KEY — 会话 Cookie 签名密钥
# 格式：至少 32 字符的随机文本；init 生成 64 位十六进制文本
# 要求/缺失影响：本地/生产必填；缺失明确拒绝；不是用户密码
# 获取：仅首次新环境由 saki_local.py init 安全生成；已有值不替换
FLASK_SECRET_KEY=

# CREDENTIAL_ENCRYPTION_KEYS — 界面保存的用户模型/语音 Key 的加密密钥
# 格式：Fernet URL-safe base64 编码的 32 字节密钥；多个以逗号分隔；首个加密，其余参与解密
# 要求/缺失影响：写入用户 Key/生产/已有 credentials.json 时必需；无 Key 不能保存加密凭据
# 获取：首次 init 由 Fernet.generate_key() 生成；已有加密数据必须恢复原密钥，禁止重新生成替换
CREDENTIAL_ENCRYPTION_KEYS=

# SAKI_TEST_EMAIL — init 合成测试账号邮箱
# 格式：以 .invalid 结尾的合成邮箱
# 要求/缺失影响：仅 init 需要；默认 test@saki.invalid；不发邮件
# 获取：自行选择合成地址，不使用真实用户邮箱
SAKI_TEST_EMAIL=test@saki.invalid

# SAKI_TEST_PASSWORD — init 合成账号密码
# 格式：至少 12 字符；init 使用 secrets.token_urlsafe(18)
# 要求/缺失影响：仅 init 创建账号需要；run 不读取它进行鉴权；修改它不会重置数据库密码
# 获取：首次 init 安全随机生成；已有账号保留原密码
SAKI_TEST_PASSWORD=

# SESSION_LIFETIME_DAYS — 登录会话有效天数
# 格式：整数 >=1
# 要求/缺失影响：可省略，代码默认开发 30/生产 14；格式错会在新检查中报变量名
# 获取：按产品需求选择
# SESSION_LIFETIME_DAYS=30

# FLASK_DEBUG — 仅 app.py 直接运行的调试标志
# 格式：true/false
# 要求/缺失影响：可省略默认 false；本地离线和生产均强制关闭；saki_local.py 不使用此项开启 debug
# 获取：当前保持 false
# FLASK_DEBUG=false

# ALLOW_LEGACY_PLAINTEXT_LOGIN — 兼容旧明文账号登录
# 格式：true/false
# 要求/缺失影响：必须保持 false；生产 true 被拒绝；不是海外环境导入开关
# 获取：无需配置；不迁移旧账号
# ALLOW_LEGACY_PLAINTEXT_LOGIN=false

# GEMINI_API_KEY — 服务器侧 Gemini Key 回退
# 格式：原始 API Key 字符串，不附加 Bearer；通过 x-goog-api-key 或部分流式接口 query 传递
# 要求/缺失影响：仅真实 Gemini 功能需要，用户自己的界面 Key 优先；不填则功能明确不可用；本地仍 MOCK
# 获取：Google AI Studio 的 API Keys，申请独立测试项目 Key
# GEMINI_API_KEY=

# GEMINI_BASE_URL — Gemini API 基址
# 格式：http(s) 基础 URL，不含 /v1beta/models；代码追加 /v1beta/models/{model}:...
# 要求/缺失影响：可省略使用 Google 官方端点；自定义时来自服务商，不能空值或凭空猜测路径
# 获取：Google 官方端点或所选测试服务商文档；不是旧站地址
# GEMINI_BASE_URL=https://generativelanguage.googleapis.com

# OPENROUTER_KEY — 服务器侧 relay Key 回退
# 格式：原始 API Key，不加 Bearer（代码添加）
# 要求/缺失影响：仅真实 relay 需要；界面用户 Key 优先；本地 MOCK；与所选线路必须匹配
# 获取：所选 OpenRouter/兼容 relay 服务商的测试 Key
# OPENROUTER_KEY=

# OPENROUTER_BASE_URL — 界面 new 线路的 API 基址
# 格式：http(s) 基址；通常包含 /v1，代码追加 /chat/completions
# 要求/缺失影响：使用 new 线路时需要；已删除历史商业 relay 默认地址；不填不可调用
# 获取：从所选服务商文档复制；也可在界面选择 custom URL
# OPENROUTER_BASE_URL=

# OPENROUTER_BASE_URL_OLD — 界面 old 线路的 API 基址（old 只是线路槽名称）
# 格式：同上；必须与 OPENROUTER_KEY 或用户界面 Key 匹配
# 要求/缺失影响：使用 old 线路时需要；无 api_settings.json 时现有路由默认 old，不能假定填 new 就会使用；已删除历史默认地址
# 获取：自己选择独立测试服务商；不复制旧站 URL 或凭据
# OPENROUTER_BASE_URL_OLD=

# GEMINI_CONNECT_TIMEOUT_SECONDS — Gemini 连接超时（动态 helper 读取）
# 格式：大于 0 的有限浮点秒数
# 要求/缺失影响：可省略默认 15；历史 helper 会回退，启动检查现在明确拒绝非法值
# 获取：自行设置，非凭据
# GEMINI_CONNECT_TIMEOUT_SECONDS=15

# GEMINI_READ_TIMEOUT_SECONDS — Gemini 响应读取超时（动态 helper 读取）
# 格式：大于 0 的有限浮点秒数
# 要求/缺失影响：可省略默认 180；不是所有第三方 HTTP 调用的统一超时
# 获取：自行设置，非凭据
# GEMINI_READ_TIMEOUT_SECONDS=180

# ELEVENLABS_API_KEY — 服务器提供的语音转文字 STT Key
# 格式：原始 API Key，作为 xi-api-key 请求头
# 要求/缺失影响：仅语音消息/通话 STT 需要；缺失返回 503；不是用户 TTS Key 的回退
# 获取：ElevenLabs 工作区 API Keys，开通所需 Speech-to-Text 权限
# ELEVENLABS_API_KEY=

# SILICONFLOW_API_KEY — SiliconFlow 图片生成
# 格式：原始 API Key，代码添加 Bearer
# 要求/缺失影响：仅对应图片生成功能需要；不填不可用；当前 API 域名固定 api.siliconflow.cn
# 获取：SiliconFlow 对应站点控制台 API Keys；不能混用海外站点 Key
# SILICONFLOW_API_KEY=

# SERPER_API_KEY — Serper 图片/网页搜索
# 格式：原始 API Key，作为 X-API-KEY 请求头
# 要求/缺失影响：仅搜索/搜索辅助人设需要；不填不可用
# 获取：Serper 开发者账户的 API Key
# SERPER_API_KEY=

# COS_SECRET_ID — 对象存储身份 ID
# 格式：腾讯云分配的 SecretId 字符串
# 要求/缺失影响：真实 COS 四项必须配套；缺失不初始化客户端；本地使用文件存储替身
# 获取：腾讯云 CAM 中仅允许独立测试桶的访问凭据
# COS_SECRET_ID=

# COS_SECRET_KEY — 对象存储身份密钥
# 格式：与 SecretId 配对的原始 SecretKey
# 要求/缺失影响：同上；绝不能用旧站密钥
# 获取：腾讯云 CAM，申请独立受限测试凭据
# COS_SECRET_KEY=

# COS_REGION — 对象存储地域
# 格式：SDK 地域 ID，例如 ap-singapore，不是中文地域名/URL
# 要求/缺失影响：真实 COS 必需；参与 SDK Region 和 bucket.cos.region.myqcloud.com 域名拼接
# 获取：从独立测试桶的地域信息取得
# COS_REGION=

# COS_BUCKET — 对象存储桶名
# 格式：SDK 完整 Bucket 名（通常含 -APPID 后缀），不是 URL
# 要求/缺失影响：真实 COS 必需；只支持当前代码的默认 COS 域名构造，不是自定义 CDN 配置
# 获取：独立测试桶控制台；本任务不创建或连接桶
# COS_BUCKET=

# MAIL_SENDER — SMTP 登录账号及邮件发件人
# 格式：邮箱字符串；同时用于 login 和 From
# 要求/缺失影响：仅邮件通知/找回密码需要；缺失明确禁用
# 获取：新测试邮箱或专用测试 SMTP 账号
# MAIL_SENDER=

# MAIL_PASSWORD — SMTP 认证凭据
# 格式：邮箱服务商要求的授权码/SMTP 密码，不一定是网页登录密码
# 要求/缺失影响：仅邮件需要；不得复制旧站授权码
# 获取：测试邮箱开启 SMTP 后获取授权码或服务商 SMTP 凭据
# MAIL_PASSWORD=

# MAIL_SERVER — SMTP 主机
# 格式：主机名，不含 smtp://、端口或 URL 路径
# 要求/缺失影响：邮件必需；已删除 smtp.qq.com 隐式默认值
# 获取：测试邮箱/SMTP 服务商文档
# MAIL_SERVER=

# MAIL_PORT — SMTP SSL 端口
# 格式：整数 1–65535；代码使用 SMTP_SSL，不支持 STARTTLS 切换
# 要求/缺失影响：邮件需要；省略默认 465；不能把 587 STARTTLS 当成 SSL 使用
# 获取：服务商 SMTP_SSL 端口说明
# MAIL_PORT=465

# MAIL_RECEIVER — 后台邮件通知的备用收件人
# 格式：邮箱字符串
# 要求/缺失影响：仅通知缺少用户 email 时回退；找回密码使用请求账号邮箱，不读取此项
# 获取：仅填写可控测试收件箱，不填就没有备用收件人
# MAIL_RECEIVER=

# VAPID_PRIVATE_KEY — Web Push 签名私钥
# 格式：pywebpush 接受现存 PEM 或 base64 DER 文本文件的绝对路径（非二进制 DER），或 URL-safe base64 的 RAW 32 字节/DER；不接受把 PEM 全文当路径传入
# 要求/缺失影响：仅真实浏览器推送需要；与公钥配对；本地禁用；不自动生成
# 获取：后续用 py_vapid 生成独立 P-256 密钥对；文件应放数据根目录，使用绝对路径
# VAPID_PRIVATE_KEY=

# VAPID_PUBLIC_KEY — 浏览器 PushManager 公钥
# 格式：P-256 未压缩公钥的 URL-safe base64 字符串，前端转 Uint8Array
# 要求/缺失影响：仅推送需要；必须与私钥配对；不是 PEM 文本或文件路径
# 获取：同一次 py_vapid 密钥对生成结果
# VAPID_PUBLIC_KEY=

# NCM_APP_ID — 网易云开放平台音乐接口 appId
# 格式：平台分配字符串；请求签名中的 appId 原样使用
# 要求/缺失影响：仅音乐搜索/播放地址/歌词等网络功能需要
# 获取：网易云音乐开放平台申请应用，不是普通用户 UID
# NCM_APP_ID=

# NCM_PRIVATE_KEY — 网易云 RSA-SHA256 签名私钥
# 格式：未加密 PKCS#8 RSA PEM，或它的 base64 主体（代码补 BEGIN PRIVATE KEY）；双引号 dotenv 中可用 \n 表示实际换行
# 要求/缺失影响：仅音乐平台接口需要；与应用登记的公钥匹配；不是 API token、PKCS#1 RSA PRIVATE KEY 或文件路径
# 获取：按平台接入流程自行生成并登记配对公钥；不要无依据生成假凭据
# NCM_PRIVATE_KEY=

# PUBLIC_BASE_URL — 提供 AI 识图用图片的公开站点基址
# 格式：http(s) origin；代码只保留 scheme://netloc，忽略路径
# 要求/缺失影响：本地不需要；真实外部模型取图或部署时需可达公网 origin；不能填旧站；缺省从当前请求/代理头推导
# 获取：独立测试入口或正式部署地址；本任务不配置域名
# PUBLIC_BASE_URL=

# SITE_URL — PUBLIC_BASE_URL 的兼容别名
# 格式：同 PUBLIC_BASE_URL
# 要求/缺失影响：可省略；PUBLIC_BASE_URL 非空时不生效
# 获取：不需同时填两个；推荐 PUBLIC_BASE_URL
# SITE_URL=

# VOICE_STT_MAX_REQUESTS_PER_HOUR — 每用户语音消息批量 STT 限额
# 格式：整数 >=0；0 表示不设限（consume_voice_stt_quota）
# 要求/缺失影响：可省略默认 60；只影响相应语音功能
# 获取：按测试预算设置
# VOICE_STT_MAX_REQUESTS_PER_HOUR=60

# VOICE_STT_MAX_REALTIME_SESSIONS_PER_HOUR — 每用户语音消息实时 STT 会话限额
# 格式：整数 >=0；0 表示不设限
# 要求/缺失影响：可省略默认 60
# 获取：按测试预算设置
# VOICE_STT_MAX_REALTIME_SESSIONS_PER_HOUR=60

# VOICE_CALL_STT_SESSIONS_PER_HOUR — 每用户通话实时 STT token 限额
# 格式：整数 >=0；0 表示不设限
# 要求/缺失影响：可省略默认 240
# 获取：按测试预算设置
# VOICE_CALL_STT_SESSIONS_PER_HOUR=240

# VOICE_CALL_BATCH_STT_PER_HOUR — 每用户通话批量 STT 限额
# 格式：整数 >=0；0 表示不设限
# 要求/缺失影响：可省略默认 240
# 获取：按测试预算设置
# VOICE_CALL_BATCH_STT_PER_HOUR=240

# VOICE_CALL_STT_MAX_BYTES — 通话批量 STT 上传字节数限制
# 格式：整数 >=1024，单位字节
# 要求/缺失影响：可省略默认 10*1024*1024；不是全站上传限制
# 获取：按需求设置
# VOICE_CALL_STT_MAX_BYTES=10485760

# SQUARE_TRIAL_RATE_LIMIT_PER_MINUTE — 角色广场试玩每分钟请求数
# 格式：整数 >=1
# 要求/缺失影响：可省略默认 6；不是付费开关
# 获取：按测试预算设置
# SQUARE_TRIAL_RATE_LIMIT_PER_MINUTE=6

# SQUARE_TRIAL_PENDING_TIMEOUT_SECONDS — 角色试玩挂起请求超时
# 格式：整数 >=30，单位秒
# 要求/缺失影响：可省略默认 90
# 获取：按需求设置
# SQUARE_TRIAL_PENDING_TIMEOUT_SECONDS=90

# SQUARE_TRIAL_GEMINI_MODEL — 角色广场试玩 Gemini 模型
# 格式：Gemini API 模型 ID 字符串，不是 URL
# 要求/缺失影响：可省略使用代码默认；真实服务需确认账号对模型有权限；由 SAKI_SERVICE_GEMINI_API_KEY 支付，不读取用户 1 的 Key
# 获取：从所选 Gemini 项目的可用模型列表取得；本次未查询账户模型权限
# SQUARE_TRIAL_GEMINI_MODEL=gemini-2.5-flash

# VOICE_ANNOUNCEMENT_START — 已有语音公告展示起点
# 格式：datetime.fromisoformat 接受的 ISO 8601 日期时间；无时区按北京时间处理
# 要求/缺失影响：可省略使用历史默认，当前已过期；并非语音功能开关
# 获取：自行决定公告排期，可保持注释
# VOICE_ANNOUNCEMENT_START=2026-08-06T00:00:00+08:00

# VOICE_ANNOUNCEMENT_END — 已有语音公告展示终点
# 格式：同上
# 要求/缺失影响：可省略使用历史默认；不调用服务
# 获取：自行决定公告排期
# VOICE_ANNOUNCEMENT_END=2026-08-13T00:00:00+08:00

# VOICE_LEGACY_DELETE_AT — 语音公告显示的历史删除时间
# 格式：同上
# 要求/缺失影响：可省略默认跟随 VOICE_ANNOUNCEMENT_END；仅展示，不执行删除任务
# 获取：自行决定文案时间，不是迁移/删除开关
# VOICE_LEGACY_DELETE_AT=

# PERSONA_LOCK_ANNOUNCEMENT_START — 已有保护人设公告起点
# 格式：ISO 8601 日期时间，建议带 +08:00
# 要求/缺失影响：可省略使用历史默认，当前已过期
# 获取：自行决定公告排期
# PERSONA_LOCK_ANNOUNCEMENT_START=2026-08-10T00:00:00+08:00

# PERSONA_LOCK_ANNOUNCEMENT_END — 已有保护人设公告终点
# 格式：同上
# 要求/缺失影响：可省略使用历史默认；不影响人设保护本身
# 获取：自行决定公告排期
# PERSONA_LOCK_ANNOUNCEMENT_END=2026-08-24T00:00:00+08:00

# KUNIGAMI_ASSESSMENT_USERNAME — 手工 scripts/run_character_ego_test.py 登录邮箱
# 格式：测试账号邮箱，命令行 --username 优先
# 要求/缺失影响：仅手工测试脚本需要；未设置可能按 --user-id 查询新项目数据库；网页不读取
# 获取：独立测试账号
# KUNIGAMI_ASSESSMENT_USERNAME=

# KUNIGAMI_ASSESSMENT_PASSWORD — 手工角色测试脚本密码
# 格式：原始账号密码；默认变量名，可由 --password-env 指定其他环境变量名
# 要求/缺失影响：仅手工脚本需要；交互可 getpass 输入；不是模型 Key；不会自动运行
# 获取：独立测试账号密码；不建议写入 .env，优先交互输入
# KUNIGAMI_ASSESSMENT_PASSWORD=

# KUNIGAMI_ASSESSMENT_SESSION_COOKIE — 手工脚本可选会话 Cookie
# 格式：脚本解析 session=... 或原始值并写名为 session 的 Cookie
# 要求/缺失影响：仅旧 Cookie 名称兼容方式；当前本地用 saki_global_session，因此不适用于本地；优先账号密码登录
# 获取：从自己的测试会话获取，勿复制旧站 Cookie；本地无需填
# KUNIGAMI_ASSESSMENT_SESSION_COOKIE=

# KUNIGAMI_ASSESSMENT_REEXEC 是脚本内部重执行标记（字符串 1），不要手填。
# USE_OPENROUTER 无任何有效分支消费者，本次删除无效读取；线路在用户界面 api_settings.json 中选择。
# agent-test/ 的 KUNIGAMI_ROOT 仅独立实验工具读取（历史默认服务器路径），不属于 Flask 启动环境，禁止当成本地启动入口。
# 无 DATABASE_URL、REDIS_URL、后台任务开关或 COS_SESSION_TOKEN 的消费代码，不添加虚构配置。

# SAKI_SERVICE_GEMINI_API_KEY — 站点公共 Sakura 助手和角色广场试聊专用
# 格式：原始 Gemini API Key，不加 Bearer；共用 GEMINI_BASE_URL。
# 要求/缺失影响：仅真实公共服务需要；不再读取用户 1 或任何用户的 Key，缺失返回 503。
# 获取：站长自己的 Google AI Studio 测试项目 Key；普通用户的模型 Key 仍在界面填写。
SAKI_SERVICE_GEMINI_API_KEY=

# SAKI_ADMIN_USER_IDS — 后台管理员名单，只读取服务端配置
# 格式：正整数用户 ID，多个用英文逗号分隔，例如 1,7
# 留空/未配置表示没有管理员；正式部署需显式填写，不会自动授权第一个注册用户
# 当前项目迁移时应显式填写 1，保留现有管理员；不要从用户请求或资料读取权限
SAKI_ADMIN_USER_IDS=
